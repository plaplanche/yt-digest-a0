{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yt-digest/contracts/log-event.schema.json",
  "title": "LogEvent",
  "description": "One log line, written as one JSON object per line.",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "level": {
      "enum": ["debug", "info", "warn", "error"]
    },
    "service": {
      "enum": ["node", "worker"]
    },
    "event": {
      "title": "LogEventName",
      "description": "The catalogue of log events.",
      "enum": [
        "service.started",
        "fetch.transcript",
        "sponsorblock.call",
        "node.enrolled",
        "node.revoked",
        "node.heartbeat",
        "job.enqueued",
        "job.claimed",
        "job.completed",
        "job.released",
        "job.lease_expired",
        "job.stale_result",
        "job.validation_failed",
        "auth.bearer.rejected",
        "auth.client.registered",
        "auth.oauth.completed",
        "auth.oauth.denied",
        "auth.token.issued",
        "auth.refresh.reuse_detected",
        "auth.origin.rejected",
        "mcp.tool.call",
        "worker.call"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "video_id": {
      "type": "string"
    },
    "attrs": {
      "type": "object"
    }
  },
  "required": ["ts", "level", "service", "event", "attrs"],
  "additionalProperties": false
}
